# Copy this file to .env and fill in your values (for local runs).
# On GitHub Actions, set these as repository secrets instead.

OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
OPENROUTER_MODEL_1=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL_2=nvidia/nemotron-3-super-120b-a12b:free
GMAIL_ADDRESS=yourgmail@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword

# Optional: raises Semantic Scholar rate limits for citation lookups.
# SEMANTIC_SCHOLAR_API_KEY=

# Optional: set to false to skip citation lookups entirely.
# CITATIONS_ENABLED=true